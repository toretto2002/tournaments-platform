# =====================================================================
# team-roster - variabili d'ambiente (ESEMPIO). Copia in .env e valorizza.
# NON committare .env.
# =====================================================================

# --- App ---
APP_NAME=team-roster
APP_ENV=local
LOG_LEVEL=info
PORT=8004

# Database (PostgreSQL dedicato al servizio)
DATABASE_URL=postgresql+asyncpg://team-roster:password@localhost:5432/team_roster_db

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=team-roster-service
# TODO: allineare i topic prodotti/consumati con contracts/asyncapi.yaml
