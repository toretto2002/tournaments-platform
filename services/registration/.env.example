# =====================================================================
# registration - variabili d'ambiente (ESEMPIO). Copia in .env e valorizza.
# NON committare .env.
# =====================================================================

# --- App ---
APP_NAME=registration
APP_ENV=local
LOG_LEVEL=info
PORT=8005

# Database (PostgreSQL dedicato al servizio)
DATABASE_URL=postgresql+asyncpg://registration:password@localhost:55432/registration_db

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=registration-service
# TODO: allineare i topic prodotti/consumati con contracts/asyncapi.yaml
