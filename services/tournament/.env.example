# =====================================================================
# tournament - variabili d'ambiente (ESEMPIO). Copia in .env e valorizza.
# NON committare .env.
# =====================================================================

# --- App ---
APP_NAME=tournament
APP_ENV=local
LOG_LEVEL=info
PORT=8002

# Database (PostgreSQL dedicato al servizio)
DATABASE_URL=postgresql+asyncpg://tournament:changeme@localhost:5432/tournament_db

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=tournament-service
# TODO: allineare i topic prodotti/consumati con contracts/asyncapi.yaml
