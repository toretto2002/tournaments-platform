# =====================================================================
# documents - variabili d'ambiente (ESEMPIO). Copia in .env e valorizza.
# NON committare .env.
# =====================================================================

# --- App ---
APP_NAME=documents
APP_ENV=local
LOG_LEVEL=info
PORT=8006

# Database (PostgreSQL dedicato al servizio)
DATABASE_URL=postgresql+asyncpg://documents:changeme@localhost:5432/documents_db

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=documents-service
# TODO: allineare i topic prodotti/consumati con contracts/asyncapi.yaml

# Object storage (S3-compatibile)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=documents
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme