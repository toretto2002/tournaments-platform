# =====================================================================
# identity - variabili d'ambiente (ESEMPIO). Copia in .env e valorizza.
# NON committare .env.
# =====================================================================

# --- App ---
APP_NAME=identity
APP_ENV=local
LOG_LEVEL=info
PORT=8001

# Database (PostgreSQL dedicato al servizio)
DATABASE_URL=postgresql+asyncpg://identity:password@localhost:55432/identity_db

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=identity-service
# TODO: allineare i topic prodotti/consumati con contracts/asyncapi.yaml

# --- Sicurezza / JWT (EdDSA - Ed25519) ---
# Path delle chiavi Ed25519 usate per firmare/verificare i JWT.
# Generale con: uv run python scripts/generate_keys.py
# JWT_PRIVATE_KEY_PATH=keys/jwt_ed25519_private.pem
# JWT_PUBLIC_KEY_PATH=keys/jwt_ed25519_public.pem
# JWT_ISSUER=identity
# JWT_KID=identity-ed25519-1
# ACCESS_TOKEN_TTL_SECONDS=1800
