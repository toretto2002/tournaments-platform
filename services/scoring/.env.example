# =====================================================================
# scoring - variabili d'ambiente (ESEMPIO). Copia in .env e valorizza.
# NON committare .env.
# =====================================================================

# --- App ---
APP_NAME=scoring
APP_ENV=local
LOG_LEVEL=info
PORT=8007

# Database (PostgreSQL dedicato al servizio)
DATABASE_URL=postgresql+asyncpg://scoring:changeme@localhost:5432/scoring_db

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=scoring-service
