# =====================================================================
# sport-rules - variabili d'ambiente (ESEMPIO). Copia in .env e valorizza.
# NON committare .env.
# =====================================================================

# --- App ---
APP_NAME=sport-rules
APP_ENV=local
LOG_LEVEL=info
PORT=8003

# Database (MongoDB)
MONGODB_URL=mongodb://localhost:27017/sport_rules_db

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=sport-rules-service
# TODO: allineare i topic prodotti/consumati con contracts/asyncapi.yaml
